{
  "name": "@jiesou/dsh-cline-free-provider",
  "version": "0.1.23-metamath.1",
  "description": "Free-tier Cline LLM provider for DeepSeek Harness (with MetaMath multi-key failover pool)",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-launch-environment": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-util-values": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/schemastery": ">=3.18.1 <4",
    "@earendil-works/pi-ai": ">=1.0.0 <2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-credentials": { "optional": true }
  }
}
