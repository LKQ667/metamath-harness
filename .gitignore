# 依赖与构建产物
node_modules/
lib/
dist/
.portable-build/
.portable-cache/
# 皮肤插件无构建步骤，lib/ 即源码，需保留
!plugins/dsh-client-ui-skins/lib/

# 运行时用户状态（严禁提交）
data/
sessions/
storages/
logs/
cache/
.credentials.yaml
.anonymous-user-id
.env
.env.*
*.log

# 测试与验收证据
evidence/
.playwright-cli/
.playwright-mcp/

# DSH 运行时在本仓库 .dsh 内生成的用户状态（对方首次启动后出现，勿提交）
.dsh/settings.yaml
.dsh/settings.yaml.bak*
.dsh/data/
.dsh/logs/
.dsh/storages/
.dsh/sessions/
.dsh/cache/
.dsh/runtime/
